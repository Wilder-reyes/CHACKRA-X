# Private backend configuration. Copy locally only; never commit real credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required only when authenticated Earthdata downloads are explicitly enabled.
EARTHDATA_TOKEN=
GPM_DOWNLOADS_ENABLED=false
# Optional cache directory. Empty selects backend/.cache.
CHACKRAX_CACHE_DIR=
CHACKRAX_HISTORY_WAIT=20

# Optional private scientific object archive; configure only when available.
CHACKRAX_OBJECT_BUCKET=
CHACKRAX_OBJECT_ENDPOINT=
CHACKRAX_OBJECT_REGION=auto
CHACKRAX_ARCHIVE_PREFIX=chackrax-nasa-v1
CHACKRAX_ARCHIVE_BUCKET=chackrax-nasa-archive
CHACKRAX_R2_ENABLED=0
